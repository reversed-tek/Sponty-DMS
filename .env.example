# Supabase Configuration
# Copy this file to .env.local (for local development) or configure in Vercel

# Your Supabase project URL
# Find this in: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public key
# Find this in: Supabase Dashboard > Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Note: Never commit your actual .env.local file to version control
# The anon key is safe to use in the browser (use Row Level Security to protect data)
